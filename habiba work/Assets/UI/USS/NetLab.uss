.app {
    --bg: rgb(238, 241, 246);
    --surface: rgb(255, 255, 255);
    --surface-2: rgb(247, 248, 251);
    --surface-3: rgb(237, 240, 245);
    --border: rgb(220, 225, 233);
    --text: rgb(23, 32, 51);
    --muted: rgb(105, 115, 134);
    --faint: rgb(154, 164, 181);
    --accent: rgb(89, 106, 242);
    --accent-2: rgb(126, 138, 255);
    --accent-soft: rgb(238, 240, 255);
    --teal: rgb(35, 183, 170);
    width: 100%;
    height: 100%;
    min-width: 950px;
    min-height: 620px;
    color: var(--text);
    background-color: var(--bg);
    font-size: 12px;
}

.app.theme-dark {
    --bg: rgb(16, 20, 28);
    --surface: rgb(24, 29, 39);
    --surface-2: rgb(29, 35, 48);
    --surface-3: rgb(36, 43, 57);
    --border: rgb(48, 56, 71);
    --text: rgb(238, 241, 248);
    --muted: rgb(156, 167, 186);
    --faint: rgb(105, 115, 134);
    --accent: rgb(119, 133, 255);
    --accent-2: rgb(152, 163, 255);
    --accent-soft: rgb(39, 45, 80);
    --teal: rgb(57, 200, 186);
}

Button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: var(--text);
    background-color: rgba(0, 0, 0, 0);
}

.topbar {
    height: 68px;
    min-height: 68px;
    padding-left: 20px;
    padding-right: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    background-color: var(--surface);
}

.brand {
    width: 310px;
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    width: 38px;
    height: 38px;
    margin-right: 11px;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgb(82, 100, 239);
    border-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold;
}

.brand-copy,
.tray-copy,
.ai-copy,
.device-copy,
.interface-copy,
.route-copy {
    flex-direction: column;
}

.brand-name {
    font-size: 17px;
    -unity-font-style: bold;
}

.brand-subtitle,
.tray-subtitle {
    margin-top: 1px;
    color: var(--muted);
    font-size: 10px;
}

.main-nav {
    height: 100%;
    flex-direction: row;
    align-items: center;
}

.nav-button {
    height: 100%;
    min-width: 54px;
    margin-left: 9px;
    margin-right: 9px;
    padding-left: 4px;
    padding-right: 4px;
    color: var(--muted);
    font-size: 12px;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.nav-button.active {
    color: var(--text);
    border-bottom-color: var(--accent);
}

.top-actions {
    width: 310px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.save-state {
    margin-right: 10px;
    flex-direction: row;
    align-items: center;
    color: var(--muted);
    font-size: 10px;
}

.save-check {
    margin-right: 4px;
    color: var(--teal);
}

.icon-button,
.more-button {
    width: 32px;
    height: 32px;
    color: var(--muted);
    font-size: 17px;
}

.icon-button:hover,
.more-button:hover {
    color: var(--text);
}

.theme-toggle {
    width: 66px;
    height: 32px;
    margin-left: 8px;
    margin-right: 12px;
    padding: 3px;
    flex-direction: row;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 18px;
    background-color: var(--surface-2);
}

.theme-option {
    width: 29px;
    height: 26px;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    border-radius: 13px;
}

.theme-option.active {
    color: var(--accent);
    background-color: var(--surface);
}

.avatar {
    width: 32px;
    height: 32px;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgb(108, 84, 199);
    border-radius: 16px;
    font-size: 10px;
    -unity-font-style: bold;
}

.workspace {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    background-color: var(--border);
}

.stage-panel {
    flex-grow: 1;
    min-width: 560px;
    margin-right: 1px;
    background-color: var(--surface);
}

.stage-toolbar {
    height: 66px;
    min-height: 66px;
    padding-left: 22px;
    padding-right: 17px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.lab-heading {
    justify-content: center;
}

.lab-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.lab-subtitle {
    margin-top: 3px;
    color: var(--muted);
    font-size: 10px;
}

.toolbar-group {
    flex-direction: row;
    align-items: center;
}

.tool {
    width: 32px;
    height: 32px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
    color: var(--muted);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 7px;
    font-size: 18px;
}

.tool:hover,
.tool.active {
    color: var(--accent);
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    background-color: var(--surface-2);
}

.tool-separator {
    width: 1px;
    height: 21px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: var(--border);
}

.simulation-button {
    height: 32px;
    padding-left: 11px;
    padding-right: 11px;
    flex-direction: row;
    align-items: center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
    background-color: var(--surface-2);
    font-size: 10px;
    -unity-font-style: bold;
}

.simulation-icon {
    margin-right: 7px;
}

.simulation-button.running .simulation-icon {
    color: var(--teal);
}
/* 
.topology-viewport {
    position: relative;
    flex-grow: 1;
    min-height: 360px;
    overflow: hidden;
    background-color: rgb(21, 27, 37);
    -unity-background-scale-mode: scale-and-crop;
} */

.device-node-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.viewport-badge {
    position: absolute;
    left: 16px;
    top: 14px;
    height: 29px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    color: var(--muted);
    background-color: rgba(24, 29, 39, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
    font-size: 9px;
}

.live-dot,
.status-dot {
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: var(--teal);
}

.device-node {
    position: absolute;
    width: 122px;
    height: 48px;
    padding-left: 7px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
    translate: -50% -50%;
    color: var(--text);
    background-color: rgba(24, 29, 39, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 9px;
}

.app.theme-light .device-node {
    background-color: rgba(255, 255, 255, 0.94);
}

.device-node:hover {
    translate: -50% -54%;
}

.device-node.selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.device-glyph {
    width: 32px;
    height: 32px;
    margin-right: 7px;
    -unity-text-align: middle-center;
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 7px;
    font-size: 20px;
}

.device-copy {
    flex-grow: 1;
    min-width: 0;
}

.device-name {
    font-size: 9px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.device-subtitle {
    color: var(--muted);
    font-size: 7px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.device-node .status-dot {
    width: 5px;
    height: 5px;
    margin-left: 4px;
    margin-right: 0;
}

.axis {
    position: absolute;
    left: 20px;
    bottom: 18px;
    width: 38px;
    height: 38px;
    color: var(--muted);
    font-size: 7px;
}

.axis-line {
    position: absolute;
    left: 7px;
    bottom: 7px;
    width: 28px;
    height: 1px;
}

.axis-x-line {
    background-color: rgb(239, 93, 115);
}

.axis-y-line {
    rotate: -52deg;
    background-color: rgb(64, 189, 166);
}

.axis-x,
.axis-y,
.axis-z {
    position: absolute;
}

.axis-x { right: 0; bottom: 1px; color: rgb(239, 93, 115); }
.axis-y { left: 8px; top: 0; color: rgb(64, 189, 166); }
.axis-z { left: 0; bottom: 0; color: rgb(102, 133, 245); }

.camera-tools {
    position: absolute;
    right: 16px;
    bottom: 112px;
    width: 31px;
    background-color: rgba(24, 29, 39, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 8px;
}

.camera-button {
    width: 30px;
    height: 30px;
    padding: 0;
    color: var(--muted);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    font-size: 17px;
}

.camera-last {
    border-bottom-width: 0;
}

.zoom-level {
    position: absolute;
    right: 54px;
    bottom: 116px;
    padding: 3px 6px;
    color: var(--muted);
    background-color: rgba(24, 29, 39, 0.88);
    border-radius: 4px;
    font-size: 7px;
}

.minimap {
    position: absolute;
    right: 16px;
    bottom: 14px;
    width: 126px;
    height: 88px;
    overflow: hidden;
    background-color: rgba(24, 29, 39, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 8px;
}

.minimap-title {
    height: 25px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    font-size: 7px;
    -unity-font-style: bold;
}

.mini-grid {
    position: relative;
    height: 63px;
    background-color: rgba(36, 43, 57, 0.65);
}

.mini-node {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background-color: var(--accent);
}

.mini-one { left: 18px; top: 38px; }
.mini-two { left: 47px; top: 19px; }
.mini-three { right: 28px; top: 25px; }
.mini-four { right: 15px; bottom: 10px; }

.mini-camera {
    position: absolute;
    left: 38px;
    top: 11px;
    width: 52px;
    height: 36px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.mini-link {
    position: absolute;
    height: 1px;
    background-color: var(--accent);
}

.mini-link-one { left: 20px; top: 33px; width: 55px; rotate: -22deg; }
.mini-link-two { left: 63px; top: 34px; width: 45px; rotate: 20deg; }

.device-tray {
    height: 106px;
    min-height: 106px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: var(--border);
    background-color: var(--surface);
}

.tray-title {
    width: 166px;
    flex-direction: row;
    align-items: center;
}

.tray-icon {
    margin-right: 9px;
    color: var(--accent);
    font-size: 18px;
}

.tray-name {
    font-size: 10px;
    -unity-font-style: bold;
}

.device-list {
    flex-direction: row;
}

.device-card {
    width: 66px;
    height: 70px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 8px;
    background-color: var(--surface-2);
}

.device-card:hover {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    translate: 0 -1px;
}

.library-glyph {
    font-size: 25px;
}

.library-label {
    margin-top: 4px;
    color: var(--text);
    font-size: 8px;
    -unity-font-style: bold;
}

.router-color { color: rgb(108, 124, 255); }
.switch-color { color: rgb(63, 191, 186); }
.pc-color { color: rgb(39, 167, 232); }
.server-color { color: rgb(165, 112, 244); }

.tray-search {
    height: 32px;
    margin-left: auto;
    padding-left: 11px;
    padding-right: 11px;
    color: var(--muted);
    background-color: var(--surface-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
    font-size: 9px;
}

.control-panel {
    width: 390px;
    min-width: 350px;
    background-color: var(--border);
}

.device-panel {
    height: 53%;
    margin-bottom: 1px;
    min-height: 0;
    background-color: var(--surface);
}

.panel-heading {
    padding: 15px 17px 7px 17px;
    flex-direction: row;
    justify-content: space-between;
}

.eyebrow {
    color: var(--muted);
    font-size: 7px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.device-heading {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
}

.device-heading-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-text-align: middle-center;
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 7px;
    font-size: 17px;
}

.selected-device-name {
    font-size: 15px;
    -unity-font-style: bold;
}

.device-meta {
    padding: 0 17px 12px 17px;
    flex-direction: row;
    align-items: center;
    color: var(--muted);
    font-size: 8px;
}

.device-meta > Label {
    margin-right: 16px;
}

.online-state {
    margin-right: 16px;
    flex-direction: row;
    align-items: center;
    color: var(--teal);
}

.tabs {
    height: 37px;
    padding-left: 17px;
    flex-direction: row;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.tab-button {
    height: 37px;
    margin-right: 22px;
    padding: 0;
    color: var(--muted);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    font-size: 9px;
    -unity-font-style: bold;
}

.tab-button.active {
    color: var(--accent-2);
    border-bottom-color: var(--accent);
}

.config-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-left: 17px;
    padding-right: 17px;
}

.form-section {
    padding-top: 13px;
    padding-bottom: 13px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.section-title {
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.section-heading {
    font-size: 10px;
    -unity-font-style: bold;
}

.section-caption {
    color: var(--muted);
    font-size: 7px;
}

.field-row {
    flex-direction: row;
}

.field-row .field {
    width: 50%;
}

.field-row .field-first {
    margin-right: 8px;
}

.field-label {
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 7px;
}

.config-field {
    height: 29px;
    font-size: 8px;
}

.config-field .unity-text-field__input {
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text);
    background-color: var(--surface-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 6px;
}

.config-field:focus .unity-text-field__input {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.gateway-field {
    margin-top: 8px;
}

.interface-row {
    height: 39px;
    flex-direction: row;
    align-items: center;
}

.port-icon {
    width: 27px;
    height: 27px;
    margin-right: 8px;
    -unity-text-align: middle-center;
    color: var(--teal);
    background-color: rgba(57, 200, 186, 0.12);
    border-radius: 6px;
    font-size: 13px;
}

.interface-name {
    font-size: 8px;
    -unity-font-style: bold;
}

.interface-status {
    margin-top: 1px;
    color: var(--muted);
    font-size: 7px;
}

.switch {
    width: 28px;
    height: 16px;
    margin-left: auto;
    padding: 2px;
    background-color: var(--surface-3);
    border-radius: 9px;
}

.switch-thumb {
    width: 12px;
    height: 12px;
    background-color: var(--faint);
    border-radius: 6px;
}

.switch.on {
    background-color: rgba(57, 200, 186, 0.25);
}

.switch.on .switch-thumb {
    translate: 12px 0;
    background-color: var(--teal);
}

.add-route {
    padding: 0;
    color: var(--accent-2);
    font-size: 8px;
    -unity-font-style: bold;
}

.route-row {
    height: 48px;
    padding-left: 9px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
}

.route-destination {
    font-size: 8px;
    -unity-font-style: bold;
}

.route-next-hop,
.route-metric {
    color: var(--muted);
    font-size: 7px;
}

.route-metric {
    margin-left: auto;
}

.delete-route {
    width: 25px;
    height: 25px;
    margin-left: 8px;
    padding: 0;
    color: var(--faint);
}

.empty-route {
    height: 42px;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
    font-size: 8px;
}

.ai-panel {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--surface);
}

.ai-heading {
    height: 52px;
    min-height: 52px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.ai-icon {
    width: 29px;
    height: 29px;
    margin-right: 9px;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgb(83, 104, 236);
    border-radius: 8px;
    font-size: 9px;
    -unity-font-style: bold;
}

.ai-title {
    font-size: 11px;
    -unity-font-style: bold;
}

.ai-status {
    margin-top: 2px;
    flex-direction: row;
    align-items: center;
    color: var(--muted);
    font-size: 7px;
}

.ai-status .live-dot {
    width: 5px;
    height: 5px;
}

.ai-settings {
    margin-left: auto;
}

.quick-actions {
    height: 39px;
    min-height: 39px;
    padding-left: 15px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.quick-button {
    height: 25px;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--muted);
    background-color: var(--surface-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 6px;
    font-size: 7px;
    -unity-font-style: bold;
}

.chat-history {
    flex-grow: 1;
    min-height: 100px;
    padding: 12px 15px;
    background-color: var(--surface-2);
}

.system-note {
    margin-bottom: 11px;
    color: var(--faint);
    font-size: 7px;
    -unity-text-align: middle-center;
}

.message {
    width: 100%;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: flex-start;
}

.message.user {
    justify-content: flex-end;
}

.message-avatar {
    width: 22px;
    height: 22px;
    margin-right: 7px;
    -unity-text-align: middle-center;
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 6px;
    font-size: 7px;
    -unity-font-style: bold;
}

.message-text {
    max-width: 88%;
    padding: 8px 10px;
    white-space: normal;
    color: var(--text);
    background-color: var(--surface);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 8px;
    font-size: 8px;
}

.message.user .message-text {
    color: white;
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.guide-card {
    margin: 10px 0 4px 29px;
    padding: 10px;
    background-color: var(--accent-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    border-radius: 8px;
}

.guide-eyebrow {
    color: var(--accent-2);
    font-size: 6px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.guide-title {
    margin-top: 4px;
    margin-bottom: 7px;
    font-size: 8px;
    -unity-font-style: bold;
}

.guide-code {
    padding: 7px;
    white-space: normal;
    color: var(--muted);
    background-color: var(--surface);
    border-radius: 5px;
    font-size: 7px;
}

.guide-button {
    margin-top: 7px;
    padding: 0;
    align-self: flex-start;
    color: var(--accent-2);
    font-size: 7px;
    -unity-font-style: bold;
}

.chat-composer {
    height: 91px;
    min-height: 91px;
    padding: 9px 14px;
    border-top-width: 1px;
    border-top-color: var(--border);
    background-color: var(--surface);
}

.chat-input {
    height: 38px;
    font-size: 8px;
}

.chat-input .unity-text-field__input {
    padding: 7px 9px;
    color: var(--text);
    background-color: var(--surface-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-radius: 7px;
    white-space: normal;
}

.chat-placeholder {
    position: absolute;
    left: 24px;
    top: 17px;
    color: var(--faint);
    font-size: 8px;
    display: none;
}

.chat-footer {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.chat-hint {
    color: var(--faint);
    font-size: 6px;
}

.send-button {
    height: 25px;
    padding-left: 10px;
    padding-right: 10px;
    color: white;
    background-color: var(--accent);
    border-radius: 6px;
    font-size: 8px;
    -unity-font-style: bold;
}

.toast {
    position: absolute;
    right: 18px;
    bottom: 18px;
    max-width: 320px;
    min-height: 36px;
    padding: 10px 13px;
    flex-direction: row;
    align-items: center;
    color: var(--text);
    background-color: var(--surface);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--teal);
    border-right-color: var(--teal);
    border-top-color: var(--teal);
    border-bottom-color: var(--teal);
    border-radius: 8px;
    opacity: 0;
    translate: 0 6px;
    font-size: 9px;
    -unity-font-style: bold;
}

.toast.visible {
    opacity: 1;
    translate: 0 0;
}

.toast-check {
    margin-right: 7px;
    color: var(--teal);
}

.app.compact-width .control-panel {
    width: 350px;
}

.app.compact-width .brand,
.app.compact-width .top-actions {
    width: auto;
}

.app.compact-width .tray-search {
    display: none;
}

.app.compact-height .stage-toolbar {
    height: 60px;
    min-height: 60px;
}

.app.compact-height .device-tray {
    height: 92px;
    min-height: 92px;
}

.app.compact-height .device-card {
    height: 61px;
}

.app.compact-height .device-panel {
    height: 55%;
}
.topology-viewport {
    flex-grow: 1;
    /* background-color: #1a1d24;
    background-image: resource("grid-pattern"); */
}
/* .topology-viewport {
    background-color: #12151c;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                      linear-gradient(0deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
} */


.topology-viewport .unity-scroller {
    /* visibility: hidden; */
}

.topology-viewport {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    background-color: rgb(21, 27, 37);
    -unity-background-scale-mode: scale-and-crop;
}

#network-content {
    width: 3000px;
    height: 3000px;
    background-color: rgb(21, 27, 37);
    background-image: linear-gradient(to right, rgba(71, 82, 101, 0.35) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(71, 82, 101, 0.35) 1px, transparent 1px);
    background-size: 40px 40px;
}

.world-render {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}